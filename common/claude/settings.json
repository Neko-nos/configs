{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv lock:*)",
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(nvidia-smi:*)",
      "Bash(stylua --config-path:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env*)",
      "Read(./**/.env)",
      "Read(./**/.env*)",
      "Read(./.direnv)",
      "Read(./.direnv/**)",
      "Read(./**/.direnv)",
      "Read(./**/.direnv/**)",
      "Read(./secrets)",
      "Read(./secrets/**)",
      "Read(./**/secrets)",
      "Read(./**/secrets/**)",
      "Read(~/.netrc)",
      "Read(~/.aws/credentials)",
      "Read(~/**/huggingface/token)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git mv:*)",
      "Bash(git restore --staged:*)",
      "Bash(git rm --cached:*)",
      "Bash(git apply --cached:*)",
      "Bash(git update-index:*)"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable"
  },
  "model": "opus[1m]",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "*"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv",
        "~/.cargo",
        "~/.cache/huggingface"
      ],
      "denyRead": [
        "./.env",
        "./.env*",
        "./**/.env",
        "./**/.env*",
        "./.direnv",
        "./.direnv/**",
        "./**/.direnv",
        "./**/.direnv/**",
        "./secrets",
        "./secrets/**",
        "./**/secrets",
        "./**/secrets/**",
        "~/.netrc",
        "~/.aws/credentials",
        "~/**/huggingface/token"
      ]
    }
  },
  "effortLevel": "xhigh",
  "skipAutoPermissionPrompt": true,
  "autoMemoryEnabled": false
}
