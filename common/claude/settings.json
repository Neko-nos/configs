{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv lock *)",
      "Bash(uv sync *)",
      "Bash(uv add *)",
      "Bash(nvidia-smi *)",
      "Bash(stylua --config-path *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env*)",
      "Read(./**/.env)",
      "Read(./**/.env*)",
      "Read(./.direnv)",
      "Read(./.direnv/**)",
      "Read(./**/.direnv)",
      "Read(./**/.direnv/**)",
      "Read(./secrets)",
      "Read(./secrets/**)",
      "Read(./**/secrets)",
      "Read(./**/secrets/**)",
      "Read(~/.netrc)",
      "Read(~/.aws/credentials)",
      "Read(~/**/huggingface/token)"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable"
  },
  "model": "opus",
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "*"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv",
        "~/.cargo",
        "~/.cache/huggingface"
      ],
      "denyRead": [
        "./.env",
        "./.env*",
        "./**/.env",
        "./**/.env*",
        "./.direnv",
        "./.direnv/**",
        "./**/.direnv",
        "./**/.direnv/**",
        "./secrets",
        "./secrets/**",
        "./**/secrets",
        "./**/secrets/**",
        "~/.netrc",
        "~/.aws/credentials",
        "~/**/huggingface/token"
      ]
    }
  },
  "autoMemoryEnabled": false,
  "skipAutoPermissionPrompt": true,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  }
}
