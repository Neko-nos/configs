{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/uv\" run --project \"$HOME/configs/common/codex/hooks\" \"$HOME/configs/common/codex/hooks/capture_turn.py\"",
            "timeout": 30,
            "statusMessage": "Capturing turn diff baseline"
          },
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/uv\" run --project \"$HOME/configs/common/codex/hooks\" \"$HOME/configs/common/codex/hooks/prune_turns.py\" --retention-days 30",
            "timeout": 30,
            "statusMessage": "Pruning old turn reviews"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/uv\" run --project \"$HOME/configs/common/codex/hooks\" \"$HOME/configs/common/codex/hooks/save_turn.py\"",
            "timeout": 30,
            "statusMessage": "Saving turn diff"
          }
        ]
      }
    ]
  }
}
