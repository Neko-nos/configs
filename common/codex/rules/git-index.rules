# These commands only stage, unstage, or reorganize recoverable repository changes.
# ref: https://learn.chatgpt.com/docs/agent-approvals-security#protected-paths-in-writable-roots
prefix_rule(pattern=["git", "add"], decision="prompt", justification="Review staging changes outside the workspace sandbox")
prefix_rule(pattern=["git", "mv"], decision="prompt", justification="Review tracked-file renames outside the workspace sandbox")
prefix_rule(pattern=["git", "restore", "--staged"], decision="prompt", justification="Review unstaging changes outside the workspace sandbox")
prefix_rule(pattern=["git", "rm", "--cached"], decision="prompt", justification="Review removing paths from the index without deleting working-tree files")
prefix_rule(pattern=["git", "apply", "--cached"], decision="prompt", justification="Review applying patches to the index without changing working-tree files")
prefix_rule(pattern=["git", "update-index", "--refresh"], decision="prompt", justification="Review refreshing cached file metadata")
prefix_rule(pattern=["git", "update-index", "--really-refresh"], decision="prompt", justification="Review refreshing cached file metadata")
