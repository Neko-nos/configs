{
  "block-sensitive-files": {
    "PreToolUse": [
      {
        "matcher": "read_file|write_file|edit_file|run_command|run_workflow|view_file|view_file_outline|view_code_item|write_to_file|replace_file_content|multi_replace_file_content|list_dir|find_by_name|grep_search|generate_image",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/uv\" run --no-project \"$HOME/configs/common/gemini/hooks/block_sensitive_files.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "turn-diff": {
    "SessionStart": [
      {
        "type": "command",
        "command": "\"$HOME/.local/bin/uv\" run --project \"$HOME/configs/common/hooks/turn-diff\" \"$HOME/configs/common/hooks/turn-diff/prune_turns.py\" --retention-days 30",
        "timeout": 30
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "\"$HOME/.local/bin/uv\" run --project \"$HOME/configs/common/hooks/turn-diff\" \"$HOME/configs/common/hooks/turn-diff/capture_turn.py\"",
        "timeout": 30
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "\"$HOME/.local/bin/uv\" run --project \"$HOME/configs/common/hooks/turn-diff\" \"$HOME/configs/common/hooks/turn-diff/save_turn.py\"",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "\"$HOME/.local/bin/uv\" run --project \"$HOME/configs/common/hooks/turn-diff\" \"$HOME/configs/common/hooks/turn-diff/save_turn.py\"",
        "timeout": 30
      }
    ]
  }
}
