#!/usr/bin/env bash

set -euo pipefail

#######################################
# Keep a stable agent path available across SSH reconnects on Linux servers.
# Globals:
#   SSH_AUTH_SOCK
# Arguments:
#   None
# Outputs:
#   Writes filesystem errors to stderr.
# Returns:
#   0 if the link is updated or no usable agent is available; nonzero on error.
#######################################
function main() {
    local runtime_dir pending_link

    # Shared home directories must not share agent links between servers.
    runtime_dir="/run/user/$(id -u)"
    [[ -d "${runtime_dir}" && -S "${SSH_AUTH_SOCK}" ]] || return 0
    [[ "${SSH_AUTH_SOCK}" != "${runtime_dir}/ssh-agent-current" ]] || return 0

    # A disconnected forwarding channel must not leave the hook waiting indefinitely.
    timeout 5 ssh-add -l >/dev/null 2>&1 || return 0

    # Preserve VS Code's symlink so its own reconnect updates remain effective.
    pending_link="${runtime_dir}/ssh-agent-current.$$"
    ln -s -- "${SSH_AUTH_SOCK}" "${pending_link}"
    mv -T -- "${pending_link}" "${runtime_dir}/ssh-agent-current"
}

main "$@"
