{
    "name": "browser-click-routing",
    "displayName": "Browser Click Routing",
    "description": "Opens Cmd-clicked URLs inside VS Code and Ctrl-clicked URLs externally.",
    "version": "0.1.0",
    "private": true,
    "publisher": "Neko-nos",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Neko-nos/configs.git",
        "directory": "VSCode/extensions/browser-click-routing"
    },
    "engines": {
        "vscode": "^1.131.0"
    },
    "extensionKind": [
        "ui"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onOpenExternalUri:http",
        "onOpenExternalUri:https"
    ],
    "enabledApiProposals": [
        "externalUriOpener",
        "terminalDataWriteEvent",
        "terminalDimensions"
    ],
    "main": "./extension.js",
    "scripts": {
        "check": "biome check --error-on-warnings .",
        "format": "biome check --write .",
        "package": "vsce package"
    },
    "dependencies": {
        "@xterm/headless": "6.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@vscode/vsce": "4.0.0"
    },
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": true
        }
    }
}
