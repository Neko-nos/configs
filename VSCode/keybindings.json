[
    {
        "key": "shift+enter",
        "command": "workbench.action.terminal.sendSequence",
        // ESC+CR (Alt+Enter) survives local and SSH tmux sessions and inserts a newline across agy, Codex, Claude Code, and Zsh.
        "args": { "text": "\u001b\r" },
        "when": "terminalFocus"
    },
    {
        // Route text and images through the same paste shortcut in terminal prompts.
        "key": "cmd+v",
        "command": "smartTerminalPaste.paste",
        "when": "terminalFocus"
    },
    {
        // tmux owns its mouse selection, so forward Ctrl+C when VSCode has no selection of its own.
        "key": "cmd+c",
        "command": "workbench.action.terminal.sendSequence",
        "args": { "text": "\u0003" },
        "when": "terminalFocus && !terminalTextSelected && !terminalTextSelectedInFocused"
    },
    {
        // Forward nano's Ctrl+Z undo binding through local and remote terminals.
        "key": "cmd+z",
        "command": "workbench.action.terminal.sendSequence",
        "args": { "text": "\u001a" },
        "when": "terminalFocus"
    },
    {
        // Forward tmux's prefix instead of letting VSCode handle it.
        "key": "ctrl+a",
        "command": "workbench.action.terminal.sendSequence",
        "args": { "text": "\u0001" },
        "when": "terminalFocus"
    },

    {
        "key": "shift+alt+m",
        "command": "markdown.preview.refresh"
    },

    // Emacs-style editor editing.
    {
        "key": "ctrl+a",
        "command": "cursorHome",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+e",
        "command": "cursorEnd",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+b",
        "command": "cursorLeft",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+f",
        "command": "cursorRight",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+p",
        "command": "cursorUp",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+n",
        "command": "cursorDown",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+d",
        "command": "deleteRight",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+h",
        "command": "deleteLeft",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+k",
        "command": "deleteAllRight",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+u",
        "command": "deleteAllLeft",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+w",
        "command": "deleteWordLeft",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+y",
        "command": "editor.action.clipboardPasteAction",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+t",
        "command": "editor.action.transposeLetters",
        "when": "editorTextFocus && !terminalFocus"
    },

    {
        "key": "ctrl+w",
        "command": "-workbench.action.closeActiveEditor"
    },
    {
        "key": "cmd+w",
        "command": "-workbench.action.closeActiveEditor"
    }
]
