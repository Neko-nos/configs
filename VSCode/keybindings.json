[
    {
        "key": "shift+enter",
        "command": "workbench.action.terminal.sendSequence",
        // Bracketed paste keeps the newline literal across local and SSH tmux sessions.
        "args": { "text": "\u001b[200~\n\u001b[201~" },
        "when": "terminalFocus"
    },
    {
        // Route text and images through the same paste shortcut in terminal prompts.
        "key": "cmd+v",
        "command": "smartTerminalPaste.paste",
        "when": "terminalFocus"
    },
    {
        // Preserve the shell's ctrl+u while the bundle-wide Codex prompt mapping is active.
        "key": "cmd+shift+left",
        "command": "workbench.action.terminal.sendSequence",
        "args": { "text": "\u0015" },
        "when": "terminalFocus"
    },
    {
        // Forward tmux's prefix instead of letting VSCode handle it.
        "key": "ctrl+a",
        "command": "workbench.action.terminal.sendSequence",
        "args": { "text": "\u0001" },
        "when": "terminalFocus"
    },

    {
        "key": "shift+alt+m",
        "command": "markdown.preview.refresh"
    },

    // Emacs-style editor editing.
    {
        "key": "ctrl+a",
        "command": "cursorHome",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+e",
        "command": "cursorEnd",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+b",
        "command": "cursorLeft",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+f",
        "command": "cursorRight",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+p",
        "command": "cursorUp",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+n",
        "command": "cursorDown",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+d",
        "command": "deleteRight",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+h",
        "command": "deleteLeft",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+k",
        "command": "deleteAllRight",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+u",
        "command": "deleteAllLeft",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+w",
        "command": "deleteWordLeft",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+y",
        "command": "editor.action.clipboardPasteAction",
        "when": "editorTextFocus && !terminalFocus"
    },
    {
        "key": "ctrl+t",
        "command": "editor.action.transposeLetters",
        "when": "editorTextFocus && !terminalFocus"
    },

    {
        "key": "ctrl+w",
        "command": "-workbench.action.closeActiveEditor"
    },
    {
        "key": "cmd+w",
        "command": "-workbench.action.closeActiveEditor"
    }
]
