export PATH="${HOME}/spack/bin:${HOME}/.local/bin:${PATH}"
if command -v spack >/dev/null 2>&1 \
    && [[ -d "${HOME}/spack/var/spack/environments/$(spack arch)/server" ]]; then
    # Activation prints shell assignments that must run here to update PATH.
    eval "$(spack env activate --sh "${HOME}/spack/var/spack/environments/$(spack arch)/server")"
fi

# Envs used for .zshrc
export VISUAL="code --wait"
export EDITOR="nano"
export LESS='-F -g -i -M -R -W -X -z-4 -x4 --mouse --wheel-lines=8'
export FILTER_CMD="fzf"
export CONFIGS_COMMON_ZSH="$HOME/configs/common/zsh"
export __os_specific_zsh_var="CONFIGS_${OSTYPE//[^a-zA-Z0-9]/_}_ZSH"
export ${__os_specific_zsh_var}="$HOME/configs/Server"
unset -v __os_specific_zsh_var
